APP_NAME="Charte graphique de l'administration burkinabè"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# La documentation n'a pas de base de données. Seul le formulaire de
# contact ouvre une session, stockée en fichiers.
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Formulaire de contact
CONTACT_DESTINATAIRE=
MAIL_MAILER=log
MAIL_FROM_ADDRESS=ne-pas-repondre@chartegraphique.gov.bf
MAIL_FROM_NAME="Charte graphique"

