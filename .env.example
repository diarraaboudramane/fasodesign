APP_NAME="Charte graphique de l'administration burkinabè"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# La documentation n'a pas de base de données. Seules les pages Vérification
# et Nous écrire ouvrent une session, stockée en fichiers.
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Hébergement. En ligne derrière HTTPS : SESSION_SECURE_COOKIE=true.
# Derrière un proxy qui termine le TLS : son adresse dans
# MANDATAIRES_DE_CONFIANCE. Serveur de test : CHARTE_INDEXABLE=false.
SESSION_SECURE_COOKIE=false
MANDATAIRES_DE_CONFIANCE=
CHARTE_INDEXABLE=true

# Vérification anti-robot à l'entrée du site, et sa durée en minutes.
CHARTE_VERIFICATION=true
CHARTE_VERIFICATION_DUREE=1440

# Formulaire de contact
CONTACT_DESTINATAIRE=
MAIL_MAILER=log
MAIL_FROM_ADDRESS=ne-pas-repondre@chartegraphique.gov.bf
MAIL_FROM_NAME="Charte graphique"

# reCAPTCHA v2, case à cocher. Ces valeurs sont les clés d'essai publiques
# de Google : la case est toujours validée. Elles sont refusées en
# production ; créer les vraies clés dans la console reCAPTCHA.
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
