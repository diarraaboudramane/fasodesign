{
  "name": "@gouv-bf/charte-graphique",
  "version": "2.0.0",
  "description": "Charte graphique des services numériques de l'administration burkinabè : jetons, composants CSS, comportements sans dépendance.",
  "homepage": "https://fasodesign.gov.bf/",
  "repository": {
    "type": "git",
    "url": "git+https://A-RENSEIGNER/charte-graphique.git"
  },
  "bugs": {
    "url": "https://fasodesign.gov.bf/issues"
  },
  "author": "A-RENSEIGNER (autorite de tutelle du systeme)",
  "license": "SEE LICENSE IN LISEZMOI-PAQUET.txt",
  "type": "commonjs",
  "scripts": {
    "jetons": "node outils/jetons.js",
    "verifier-jetons": "node outils/jetons.js --verifier",
    "android": "node outils/android.js",
    "verifier-android": "node outils/android.js --verifier",
    "verifier": "node outils/verifier.js",
    "test": "node outils/verifier.js",
    "site": "node outils/site.js",
    "local": "node outils/site.js && httpd -f hebergement/apache-local.conf -DFOREGROUND"
  },
  "main": "./assets/js/faso.js",
  "types": "./assets/js/faso.d.ts",
  "exports": {
    ".": {
      "types": "./assets/js/faso.d.ts",
      "default": "./assets/js/faso.js"
    },
    "./amorce": "./assets/js/faso-amorce.js",
    "./css/tokens.css": "./assets/css/tokens.css",
    "./css/faso.css": "./assets/css/faso.css",
    "./css/icones.css": "./assets/css/icones.css",
    "./jetons.json": "./assets/jetons.json",
    "./img/armoiries.svg": "./assets/img/armoiries.svg",
    "./img/icones.svg": "./assets/img/icones.svg",
    "./polices/*": "./assets/polices/*",
    "./package.json": "./package.json",
    "./android/*": "./android/*"
  },
  "sideEffects": [
    "*.css",
    "./assets/js/faso.js",
    "./assets/js/faso-amorce.js"
  ],
  "files": [
    "README.md",
    "assets/css/tokens.css",
    "assets/css/faso.css",
    "assets/css/icones.css",
    "assets/js/faso.js",
    "assets/js/faso-amorce.js",
    "assets/js/faso.d.ts",
    "assets/img",
    "assets/polices",
    "assets/jetons.json",
    "android",
    "LISEZMOI-PAQUET.txt"
  ],
  "keywords": [
    "charte-graphique",
    "design-system",
    "burkina-faso",
    "service-public",
    "accessibilite",
    "rgaa",
    "wcag"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
