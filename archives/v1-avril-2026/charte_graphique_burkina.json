  "typographie": {
    "polices": {
      "titres": {
        "nom": "Poppins",
        "fabricant": "Indian Type Foundry",
        "google_fonts": "https://fonts.google.com/specimen/Poppins",
        "poids": [300, 400, 500, 600, 700, 800],
        "utilisation": "Titres H1-H6, navigation, boutons, badges",
        "fallback": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
      },
      "corps": {
        "nom": "Inter",
        "fabricant": "Rasmus Andersson (Meta)",
        "google_fonts": "https://fonts.google.com/specimen/Inter",
        "poids": [300, 400, 500, 600, 700],
        "utilisation": "Corps de texte, paragraphs, formulaires",
        "fallback": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
      },
      "mono": {
        "nom": "JetBrains Mono",
        "fabricant": "JetBrains",
        "google_fonts": "https://fonts.google.com/specimen/JetBrains+Mono",
        "poids": [400, 500],
        "utilisation": "Code, hex codes, valeurs techniques",
        "fallback": "'Consolas', 'Monaco', monospace"
      }
    },
    "echelle": {
      "h1": {"taille": "42px", "poids": 800, "famille": "Poppins", "line_height": 1.15},
      "h2": {"taille": "32px", "poids": 700, "famille": "Poppins", "line_height": 1.2},
      "h3": {"taille": "24px", "poids": 600, "famille": "Poppins", "line_height": 1.3},
      "h4": {"taille": "20px", "poids": 600, "famille": "Poppins", "line_height": 1.35},
      "h5": {"taille": "18px", "poids": 500, "famille": "Poppins", "line_height": 1.4},
      "body": {"taille": "15px", "poids": 400, "famille": "Inter", "line_height": 1.6},
      "small": {"taille": "13px", "poids": 400, "famille": "Inter", "line_height": 1.5},
      "caption": {"taille": "11px", "poids": 500, "famille": "Inter", "line_height": 1.4, "transform": "uppercase", "letter_spacing": "1px"}
    }
  },

