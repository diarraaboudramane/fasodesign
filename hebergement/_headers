# Charte graphique de l'administration burkinabè
# En-têtes pour un hébergement de type Cloudflare Pages ou Netlify.
# À déposer à la racine du site publié.
#
# Deux règles suffisent à tout comprendre :
#
#   une adresse qui porte un numéro de version ne change jamais, donc
#   elle se met en cache pour un an ;
#
#   une adresse sans numéro de version peut changer, donc elle se
#   revalide à chaque visite.

# ---------------------------------------------------------------- pages
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  X-Robots-Tag: noai, noimageai
  TDM-Reservation: 1
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# ------------------------------------------------- diffusion versionnée
# https://chartegraphique.gov.bf/2.0.0/css/faso.css
# Le contenu de ces adresses est figé : une correction sort sous un
# nouveau numéro, elle ne réécrit jamais l'ancien.
/:version/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  X-Robots-Tag: noai, noimageai
  TDM-Reservation: 1

# Les polices sont demandées par la feuille de styles. Servies depuis un
# autre domaine que celui du service, elles exigent cet en-tête : sans
# lui, le navigateur télécharge le fichier puis refuse de l'employer, et
# le texte bascule silencieusement en police de repli.
/*.woff2
  Content-Type: font/woff2
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.svg
  Content-Type: image/svg+xml
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# ------------------------------------------------------- non versionné
# Pratique pour un essai, à proscrire en production : une correction de
# la charte modifierait l'apparence d'un service sans que personne ne
# l'ait demandé.
/latest/*
  Cache-Control: public, max-age=300
  Access-Control-Allow-Origin: *
