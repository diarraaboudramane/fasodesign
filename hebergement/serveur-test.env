# Charte graphique de l'administration burkinabè
# Modèle de .env pour le serveur de test
#
#   https://chartegraphique-21.mtdpce-test.gov.bf
#
# À copier en .env à la racine de l'application sur le serveur, puis à
# compléter là où figure « À-RENSEIGNER ». Ce fichier ne contient aucun
# secret et peut rester dans le dépôt ; le .env du serveur, lui, n'y entre
# jamais.
#
# Lors de la bascule vers chartegraphique.gov.bf, changer APP_URL,
# MAIL_FROM_ADDRESS, ajouter le domaine aux clés reCAPTCHA et passer
# CHARTE_INDEXABLE à true.

APP_NAME="Charte graphique de l'administration burkinabè"
APP_ENV=production
# php artisan key:generate --force, une fois, sur le serveur.
APP_KEY=
APP_DEBUG=false
APP_URL=https://chartegraphique-21.mtdpce-test.gov.bf

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

CACHE_STORE=file
SESSION_DRIVER=file
# Les analyses de conformité tournent en arrière-plan : un processus
# « php artisan queue:work » doit rester lancé (voir le README).
QUEUE_CONNECTION=database

# Base de l'outil de conformité (comptes, bilans). SQLite suffit pour
# les services pilotes ; le fichier est database/database.sqlite.
DB_CONNECTION=sqlite
CONFORMITE_PAGES_MAX=20
CONFORMITE_ANALYSES_PAR_JOUR=20

# Rendu JavaScript (facultatif) : Chrome ou Chromium installé sur le serveur,
# et « npm install --omit=dev » dans outils/rendu. Vide : option désactivée.
CONFORMITE_CHROME=
CONFORMITE_NODE=node

# Le site n'est servi qu'en https : le cookie de session ne part jamais
# en clair.
SESSION_SECURE_COOKIE=true

# Adresse du proxy qui termine le TLS devant l'application, s'il y en a
# un (IP ou CIDR). Vide si l'application reçoit directement les visiteurs.
MANDATAIRES_DE_CONFIANCE=

# Serveur de test : les moteurs ne doivent pas l'indexer, pour ne pas
# concurrencer le site officiel (noindex et robots.txt « Disallow: / »).
CHARTE_INDEXABLE=false

# Désactivée provisoirement : repasser à true pour rétablir la case.
CHARTE_VERIFICATION=false
# Minutes sans aucune page vue après lesquelles la case est redemandée.
# Le délai repart à chaque page : un visiteur qui lit n'est jamais
# interrompu ; il ne recoche qu'après 10 minutes d'inactivité.
CHARTE_VERIFICATION_DUREE=10

# Clés reCAPTCHA v2 « case à cocher » créées dans la console reCAPTCHA
# pour chartegraphique-21.mtdpce-test.gov.bf. Les clés d'essai de Google
# sont refusées en production : la case bloquerait tout le monde.
RECAPTCHA_SITE_KEY=6LcTeuAtAAAAANCSUWtyD4wLz3pB0oRai8Hc-_8R
RECAPTCHA_SECRET_KEY=6LcTeuAtAAAAALD1GDNUbHvsbg7Y4LGVgztyXsQr

# Courriel : formulaire de contact, et liens de confirmation et de mot de
# passe des comptes de l'outil de conformité. Sans serveur de courrier,
# aucun compte ne peut être confirmé. Après réglage :
#   php artisan optimize && php artisan charte:courriel-essai votre@adresse.gov.bf
# MAIL_SCHEME : smtps pour le port 465 ; laisser vide pour 587 (STARTTLS).
CONTACT_DESTINATAIRE=À-RENSEIGNER
MAIL_MAILER=smtp
MAIL_HOST=À-RENSEIGNER
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=À-RENSEIGNER
MAIL_PASSWORD=À-RENSEIGNER
# L'adresse d'expédition doit être autorisée par le serveur de courrier,
# sans quoi les messages partent en indésirables ou sont refusés.
MAIL_FROM_ADDRESS=ne-pas-repondre@chartegraphique-21.mtdpce-test.gov.bf
MAIL_FROM_NAME="Charte graphique"
